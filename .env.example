# Copy this file to .env and fill in your own keys. Never commit .env.

# Gemini: picks part roles, moves, locomotion and idles
GEMINI_API_KEY=

# ElevenLabs: generates each creature's sound clip once
ELEVENLABS_API_KEY=

# Optional: Gemini models to try in order, comma separated (default list is in gemini.py)
# GEMINI_MODEL=
# Optional: ElevenLabs model id (default eleven_multilingual_v2)
# ELEVENLABS_MODEL=

# TiDB Cloud: the team's shared cluster. Ask Anny for the password (sent privately, never committed).
# To use a different cluster, replace all five values (see README, "Use a different TiDB cluster").
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=3P1dKMr5gGwmeJs.root
TIDB_PASSWORD=
TIDB_DATABASE=creature_farm

# Signs login cookies; any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Optional: set to 0.0.0.0 so other laptops on the same Wi-Fi can open this server (live battles)
# HOST=0.0.0.0
