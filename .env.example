# Copy this file to .env and fill in your own keys. Never commit .env.

# Gemini: picks part roles, moves, locomotion and idles
GEMINI_API_KEY=

# ElevenLabs: generates each creature's sound clip once
ELEVENLABS_API_KEY=

# Port the backend listens on
PORT=3000

# Optional: Gemini model name (default gemini-3.8-flash)
# GEMINI_MODEL=
# Optional: ElevenLabs model id (default eleven_multilingual_v2)
# ELEVENLABS_MODEL=
