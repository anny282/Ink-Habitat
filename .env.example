# Copy this file to .env and fill in your own keys. Never commit .env.

# Gemini: picks part roles, moves, locomotion and idles
GEMINI_API_KEY=

# ElevenLabs: generates each creature's sound clip once
ELEVENLABS_API_KEY=

# Port the backend listens on
PORT=3000

# Optional: Gemini models to try in order, comma separated (default list is in gemini.py)
# GEMINI_MODEL=
# Optional: ElevenLabs model id (default eleven_multilingual_v2)
# ELEVENLABS_MODEL=

# TiDB Cloud (Connect button on your cluster, "General" / PyMySQL)
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=creature_farm

# Signs login cookies; any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
